# Trading Bot Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!
#
# ============================================================================
# SECURITY HARDENING (March 2026 Audit)
# ============================================================================
#
# IMPORTANT: Sensitive keys should be encrypted!
# Use secure_key_loader.py to manage encrypted keys:
#
#   # Encrypt a key:
#   python secure_key_loader.py encrypt --key SOLANA_PRIVATE_KEY --value "YOUR_KEY" --password "YOUR_PASSWORD"
#
#   # Change password:
#   python secure_key_loader.py set-password
#
# ============================================================================

# ============================================
# API KEY SECURITY WARNINGS (CRITICAL)
# ============================================
#
# EXCHANGE API KEYS - Use least-privilege permissions:
# - Binance: Enable ONLY "Spot Trading" - DISABLE withdrawals
# - Coinbase: Enable "Trade" only - DISABLE API trading and withdrawals
# - Kraken: Use "Trade" permission only
# - Bybit: Enable "Spot Trade" only - DISABLE "Withdrawal"
# - KuCoin: Enable "Trade" only
#
# IP WHITELISTING: Configure IP restrictions on exchange API keys
# ROTATION: Rotate keys every 30-90 days
#
# ============================================

# ============================================
# ENCRYPTION PASSWORD
# ============================================
# Set this for non-interactive mode (e.g., cron jobs)
# RECOMMEND: Use prompt mode instead for better security
ENCRYPTION_PASSWORD=

# ============================================
# EXCHANGE API KEYS
# ============================================

# Binance - RESTRICTED permissions only!
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

# Coinbase - Trade-only permissions
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_SECRET=your_coinbase_secret_here

# Kraken - Trade-only permissions
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_SECRET=your_kraken_secret_here

# Bybit - Spot Trade only, NO withdrawal
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here

# KuCoin - Trade-only permissions
KUCOIN_API_KEY=your_kucoin_api_key_here
KUCOIN_SECRET=your_kucoin_secret_here
KUCOIN_PASSPHRASE=your_kucoin_passphrase_here

# ============================================
# CTRADER OPEN API (QCG broker) — see CTRADER_SETUP.md
# ============================================
# API app credentials from my.ctrader.com -> Apps & API (scope:
# "Account info and trading").
# OAuth tokens are stored automatically in data/ctrader_credentials.json
# by:  python3 trading_bot.py --ctrader-auth
CTRADER_CLIENT_ID=your_ctrader_client_id_here
CTRADER_CLIENT_SECRET=your_ctrader_client_secret_here
CTRADER_REDIRECT_URI=https://my.ctrader.com
# CTRADER_ACCOUNT_ID=            # optional override
# CTRADER_HOST=live              # live|demo

# ============================================
# SOLANA DEX
# ============================================
# Private key should be encrypted using secure_key_loader.py
# See: https://github.com/zeroclaw-labs/zeroclaw/blob/master/docs/security/README.md

SOLANA_PRIVATE_KEY=your_base58_private_key_here

# Solana RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ============================================
# ALERT NOTIFICATIONS
# ============================================

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Discord Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL

# ============================================
# BOT CONFIGURATION
# ============================================

# Trading mode: paper or live
TRADING_MODE=paper

# Initial balance for paper trading (USD)
PAPER_BALANCE=10000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# DATA BROKER LAYER
# ============================================

# CoinAPI - Unified market data
COINAPI_KEY=your_coinapi_key_here

# Amberdata - On-chain data
AMBERDATA_KEY=your_amberdata_key_here

# LunarCrush - Social sentiment
LUNARCRUSH_API_KEY=your_lunarcrush_api_key_here

# Twitter API v2
TWITTER_API_KEY=your_twitter_api_key_here

# NewsAPI
NEWS_API_KEY=your_newsapi_key_here
